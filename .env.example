# Copy to .env (next to README.md); host/herdr-substrate.sh loads it.

# How Claude Code in the actors authenticates (README: "Claude credentials"):
#   api-key      an Anthropic API key, billed per use (default)
#   oauth-token  a Claude subscription token from `claude setup-token`
# CLAUDE_AUTH=api-key

# The credential, required for `deploy` with the k8s.io credential provider
# (kind, upstream Kubernetes): stored in a Kubernetes Secret and injected by
# substrate's egress gateway. It never enters an actor. Not used with any other
# provider. Set the one CLAUDE_AUTH names.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Agent CLIs that get credentials (README: "Agents"). Every actor has all
# three; list the ones to wire up, and set their keys the same way.
# AGENTS=claude,codex,agy
# OPENAI_API_KEY=             # Codex
# GEMINI_API_KEY=             # agy (Antigravity CLI)

# Path to a checkout of https://github.com/agent-substrate/substrate
SUBSTRATE_DIR=../substrate

# buildx builder for the kit's and substrate's image pushes to localhost:5001.
# It must use the "docker" driver (see `docker buildx ls`). Docker Desktop:
# desktop-linux. Linux: default. Leave unset if your current builder already is.
# BUILDX_BUILDER=desktop-linux

# Optional overrides (defaults shown)
# KIND_CLUSTER_NAME=kind
# ATESPACE=herdr-agents
# K8S_NAMESPACE=herdr-agents
# SECRETS_NAMESPACE=herdr-agents-secrets
# HUB_NAMESPACE=herdr-hub
# WORKER_REPLICAS=2
# HERDR_VERSION=0.9.5
IDLE_SECONDS=25             # hub suspends an actor after this long without working/blocked agents (default 300)
POLL_SECONDS=5              # poll intervall (defualt 30)
# WEB_PORT=7681             # local port of `web` (herdr in the browser)
# Extra router clients, comma-separated; the hub's SPIFFE ID is always added.
# ATE_INGRESS_ALLOWED_SPIFFE_IDS=

# ---------------------------------------------------------------------------
# Production clusters (docs/production-gke.md, docs/production-kubernetes.md).
# The guides write a complete .env; these are the settings they add.
#
# KUBE_CONTEXT=gke_my-project_europe-west6_herdr-prod
# REGISTRY=europe-west6-docker.pkg.dev/my-project/herdr      # kit images
# PLATFORM=linux/amd64                                       # the nodes' platform
# CLAUDE_CODE_VERSION=2.1.0                                  # pin; default is latest
# CODEX_VERSION=0.164.0                                      # pin; default is latest
# WORKER_IMAGE=europe-west6-docker.pkg.dev/my-project/substrate/ateworker-gvisor@sha256:...
# CREDENTIAL_PROVIDER=secretmanager.googleapis.com           # default k8s.io
# CREDENTIAL_URI=ate-secret://secretmanager.googleapis.com/projects/my-project/secrets/anthropic-api-key/versions/latest
#                                            # or the secret holding a setup-token, with CLAUDE_AUTH=oauth-token
# OPENAI_CREDENTIAL_URI=ate-secret://secretmanager.googleapis.com/projects/my-project/secrets/openai-api-key/versions/latest
# GEMINI_CREDENTIAL_URI=ate-secret://secretmanager.googleapis.com/projects/my-project/secrets/gemini-api-key/versions/latest
# ATE_CLIENT_SERVICE_ACCOUNT=herdr-operator                  # kubectl-ate acts as ate-system/herdr-operator
#
# Shared browser link (step 14 of each guide). The hub's web terminal listens
# on the pod IP for IAP or oauth2-proxy; with oauth2-proxy it also requires the
# header the proxy sets for signed-in users. Defaults: 127.0.0.1 and none.
# HUB_WEB_ADDR=0.0.0.0
# HUB_WEB_AUTH_HEADER=X-Forwarded-Email                      # oauth2-proxy only
#
# Prebuilt images from the kit's GitHub workflow, instead of `image`/`hub-image`
# (README: "Prebuilt images from GitHub"). By tag or digest. The hub image's
# substrate release must match the cluster's.
# ACTOR_IMAGE=ghcr.io/OWNER/herdr-actor:1.2.3
# HUB_IMAGE=ghcr.io/OWNER/herdr-hub:1.2.3-substrate-v0.6.0
