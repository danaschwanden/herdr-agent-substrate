#!/usr/bin/env python3
"""herdr-anchor: keeps herdr client sessions alive across actor suspends.

Runs inside the actor. The hub's herdr-keeper reaches it over SSH:

    keeper (hub)  --ssh-->  herdr-anchor attach  --unix socket-->  herdr-anchor serve
                                                                      |
                                                     herdr remote-client-bridge
                                                                      |
                                                                 herdr server

`serve` owns one remote-client-bridge per session. When the actor is
suspended the SSH connection dies, but the bridge, its connection to the herdr
server and this daemon are all in the actor's memory snapshot, so they come
back exactly as they were. The keeper then reconnects over a fresh SSH session
and both sides replay what the other hasn't received. The herdr server never
sees a disconnect.

The anchor relays bytes, not herdr messages: offsets count bytes in each
direction, so it needs no knowledge of herdr's protocol.

Wire format between keeper and anchor, both directions:
    [u8 type][u32 little-endian length][payload]
    1 HELLO    keeper->anchor  JSON {"v":1,"session":str,"cmd":str|null,"recv":int}
    2 WELCOME  anchor->keeper  JSON {"status":"new"|"resumed"|"unknown","recv":int}
    3 DATA     either way      raw bytes; offsets are implicit
    4 ACK      either way      u64 little-endian: total bytes received so far
    5 CLOSE    keeper->anchor  end the session (the herdr client went away)
    6 END      anchor->keeper  JSON {"reason":str}: the bridge exited
"""
import argparse
import asyncio
import json
import os
import re
import signal
import socket
import struct
import sys
import time

SOCKET = "/run/herdr-anchor/anchor.sock"
HELLO, WELCOME, DATA, ACK, CLOSE, END = 1, 2, 3, 4, 5, 6
HEADER = struct.Struct("<BI")
MAX_MESSAGE = 64 * 1024 * 1024
# A session whose keeper never comes back is closed after this many seconds
# of *awake* time. Time spent suspended doesn't count: a parked session must
# survive a suspend of any length.
DETACHED_TTL = int(os.environ.get("HERDR_ANCHOR_DETACHED_TTL", "900"))
# Unacknowledged output kept for replay. Beyond this the session is dropped
# and the client reconnects normally.
MAX_UNACKED = int(os.environ.get("HERDR_ANCHOR_MAX_UNACKED", str(32 * 1024 * 1024)))
ACK_EVERY = 256 * 1024
SESSION_RE = re.compile(r"^[A-Za-z0-9_-]{16,128}$")


def log(*parts):
    print("[herdr-anchor]", *parts, file=sys.stderr, flush=True)


async def read_message(reader):
    header = await reader.readexactly(HEADER.size)
    kind, length = HEADER.unpack(header)
    if length > MAX_MESSAGE:
        raise ValueError(f"message of {length} bytes is too large")
    return kind, await reader.readexactly(length)


def encode(kind, payload=b""):
    return HEADER.pack(kind, len(payload)) + payload


def bridge_command(cmd):
    """The bridge command herdr asked for, minus its idle timeout.

    With --idle-timeout-v1 the bridge exits after 60 s without traffic, on a
    clock that includes suspended time. The anchor keeps the session itself
    and expires it by awake time instead.
    """
    return cmd.replace(" --idle-timeout-v1", "").replace(" '--idle-timeout-v1'", "")


class Session:
    def __init__(self, sid, proc):
        self.sid = sid
        self.proc = proc
        self.out = bytearray()     # bridge output not yet acknowledged by the keeper
        self.out_base = 0          # offset of self.out[0]
        self.out_total = 0         # bytes the bridge has produced
        self.in_total = 0          # bytes received from the keeper
        self.unacked_in = 0        # received since the last ACK we sent
        self.writer = None         # current keeper transport
        self.sent = 0              # output offset already written to self.writer
        self.end_sent = False
        self.detached_ticks = 0
        self.ended = None          # reason, once the bridge has exited
        self.write_lock = asyncio.Lock()

    def attached(self):
        return self.writer is not None and not self.writer.is_closing()

    async def flush(self):
        """Write whatever output the current transport hasn't had yet."""
        async with self.write_lock:
            await self._flush_locked()

    async def _flush_locked(self, extra=b""):
        if not self.attached():
            return
        data = bytes(self.out[self.sent - self.out_base:])
        try:
            if data:
                self.writer.write(encode(DATA, data))
                self.sent = self.out_total
            if extra:
                self.writer.write(extra)
            if self.ended and not self.end_sent and self.sent == self.out_total:
                self.writer.write(encode(END, json.dumps({"reason": self.ended}).encode()))
                self.end_sent = True
            await self.writer.drain()
        except (ConnectionError, RuntimeError):
            self.detach(self.writer)

    def detach(self, writer):
        if self.writer is writer:
            self.writer = None
            self.detached_ticks = 0

    def kill(self):
        if self.proc.returncode is None:
            try:
                self.proc.kill()
            except ProcessLookupError:
                pass


class Anchor:
    def __init__(self):
        self.sessions = {}

    async def new_session(self, sid, cmd):
        proc = await asyncio.create_subprocess_exec(
            "/bin/sh", "-c", bridge_command(cmd),
            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
            stderr=None, start_new_session=True,
        )
        session = Session(sid, proc)
        self.sessions[sid] = session
        asyncio.create_task(self.pump_output(session))
        log(f"session {sid[:8]}: bridge started (pid {proc.pid})")
        return session

    async def pump_output(self, session):
        while True:
            chunk = await session.proc.stdout.read(65536)
            if not chunk:
                break
            session.out += chunk
            session.out_total += len(chunk)
            if len(session.out) > MAX_UNACKED:
                log(f"session {session.sid[:8]}: {len(session.out)} unacknowledged bytes, dropping it")
                session.kill()
                break
            await session.flush()
        await session.proc.wait()
        session.ended = f"bridge exited with status {session.proc.returncode}"
        log(f"session {session.sid[:8]}: {session.ended}")
        await session.flush()

    def close(self, session, why):
        session.kill()
        if self.sessions.get(session.sid) is session:
            del self.sessions[session.sid]
        log(f"session {session.sid[:8]}: closed ({why})")

    async def handle(self, reader, writer):
        session = None
        try:
            kind, payload = await read_message(reader)
            if kind != HELLO:
                raise ValueError("expected HELLO")
            hello = json.loads(payload)
            sid, recv = hello.get("session", ""), int(hello.get("recv", 0))
            if hello.get("v") != 1 or not SESSION_RE.match(sid):
                raise ValueError("bad HELLO")
            session = self.sessions.get(sid)
            if session is None and hello.get("cmd") and recv == 0:
                session = await self.new_session(sid, hello["cmd"])
                status = "new"
            elif session is not None and session.out_base <= recv <= session.out_total:
                status = "resumed"
            else:
                writer.write(encode(WELCOME, json.dumps({"status": "unknown", "recv": 0}).encode()))
                await writer.drain()
                log(f"session {sid[:8]}: unknown or not resumable (recv {recv})")
                return
            if session.attached():
                old = session.writer
                session.detach(old)
                old.close()
            async with session.write_lock:
                session.writer = writer
                session.detached_ticks = 0
                session.end_sent = False
                writer.write(encode(WELCOME, json.dumps(
                    {"status": status, "recv": session.in_total}).encode()))
                # Replay everything the keeper hasn't seen; the keeper does the same.
                del session.out[: recv - session.out_base]
                session.out_base = recv
                session.sent = recv
                replay = len(session.out)
                await session._flush_locked()
            if status == "resumed":
                log(f"session {sid[:8]}: resumed (replayed {replay} bytes)")
            await self.relay(session, reader, writer)
        except (asyncio.IncompleteReadError, ConnectionError):
            pass
        except Exception as error:  # noqa: BLE001 - keep the daemon up
            log(f"connection error: {error}")
        finally:
            if session is not None:
                session.detach(writer)
            writer.close()

    async def relay(self, session, reader, writer):
        while True:
            kind, payload = await read_message(reader)
            if kind == DATA:
                if session.proc.returncode is None:
                    session.proc.stdin.write(payload)
                    await session.proc.stdin.drain()
                session.in_total += len(payload)
                session.unacked_in += len(payload)
                if session.unacked_in >= ACK_EVERY:
                    await self.send_ack(session)
            elif kind == ACK:
                (acked,) = struct.unpack("<Q", payload)
                if session.out_base <= acked <= session.out_total:
                    del session.out[: acked - session.out_base]
                    session.out_base = acked
                # Answer with our own position, so the keeper can trim too.
                await self.send_ack(session)
            elif kind == CLOSE:
                self.close(session, "keeper closed it")
                return
            else:
                raise ValueError(f"unexpected message type {kind}")

    async def send_ack(self, session):
        session.unacked_in = 0
        async with session.write_lock:
            await session._flush_locked(encode(ACK, struct.pack("<Q", session.in_total)))

    async def reap(self):
        # Counted in one-second ticks rather than by clock: after a restore
        # from a snapshot, clocks may jump, and suspended time must not count.
        while True:
            await asyncio.sleep(1)
            for session in list(self.sessions.values()):
                if session.attached():
                    continue
                session.detached_ticks += 1
                if session.detached_ticks >= DETACHED_TTL:
                    self.close(session, f"no keeper for {DETACHED_TTL}s of awake time")
                elif session.ended and session.detached_ticks >= 60:
                    self.close(session, "bridge ended and nobody came back")


async def serve(path):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    anchor = Anchor()
    old_umask = os.umask(0o177)
    server = await asyncio.start_unix_server(anchor.handle, path=path, limit=MAX_MESSAGE)
    os.umask(old_umask)
    log(f"listening on {path} (detached sessions expire after {DETACHED_TTL}s awake)")
    asyncio.create_task(anchor.reap())
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, stop.set)
    async with server:
        await stop.wait()
    for session in list(anchor.sessions.values()):
        anchor.close(session, "anchor shutting down")


def attach(path):
    """Pipe stdin/stdout (the SSH channel) to the daemon's socket."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    deadline = time.monotonic() + 10
    while True:
        try:
            sock.connect(path)
            break
        except (FileNotFoundError, ConnectionRefusedError):
            if time.monotonic() > deadline:
                print("herdr-anchor: anchor is not running", file=sys.stderr)
                return 1
            time.sleep(0.2)

    import threading

    def upload():
        try:
            while True:
                data = os.read(0, 65536)
                if not data:
                    break
                sock.sendall(data)
        except OSError:
            pass
        try:
            sock.shutdown(socket.SHUT_WR)
        except OSError:
            pass

    threading.Thread(target=upload, daemon=True).start()
    try:
        while True:
            data = sock.recv(65536)
            if not data:
                break
            view = memoryview(data)
            while view:
                view = view[os.write(1, view):]
    except OSError:
        pass
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--socket", default=os.environ.get("HERDR_ANCHOR_SOCKET", SOCKET))
    parser.add_argument("command", choices=["serve", "attach"])
    args = parser.parse_args()
    if args.command == "serve":
        asyncio.run(serve(args.socket))
        return 0
    return attach(args.socket)


if __name__ == "__main__":
    sys.exit(main())
