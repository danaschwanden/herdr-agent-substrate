#!/usr/bin/env python3
"""herdr-anchor: keeps herdr client sessions alive across actor suspends.

Runs inside the actor. The hub's herdr-keeper reaches it over SSH:

    keeper (hub)  --ssh-->  herdr-anchor attach  --unix socket-->  herdr-anchor serve
                                                                      |
                                                     herdr remote-client-bridge
                                                                      |
                                                                 herdr server

`serve` owns one remote-client-bridge per session. When the actor is
suspended the SSH connection dies, but the bridge, its connection to the herdr
server and this daemon are all in the actor's memory snapshot, so they come
back exactly as they were. The keeper then reconnects over a fresh SSH session
and both sides replay what the other hasn't received. The herdr server never
sees a disconnect.

The anchor relays bytes, not herdr messages: offsets count bytes in each
direction, so it needs no knowledge of herdr's protocol. The wire format is in
common/herdr_wire.py, shared with the keeper.

Settings (environment):
    HERDR_ANCHOR_DETACHED_TTL  seconds of awake time a session waits for its
                               keeper before it is closed (default 900)
    HERDR_ANCHOR_MAX_UNACKED   bridge output kept for replay; a session that
                               exceeds it is closed (default 32 MiB)
    HERDR_ANCHOR_SOCKET        the daemon's socket (default below)
"""
import argparse
import asyncio
import json
import os
import re
import shlex
import signal
import socket
import sys
import threading
import time


def _import_wire():
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.environ.get("HERDR_WIRE_DIR"), "/usr/local/lib/herdr-substrate",
                 os.path.join(here, "..", "common")):
        if path and os.path.exists(os.path.join(path, "herdr_wire.py")):
            sys.path.insert(0, path)
            break
    import herdr_wire
    return herdr_wire


wire = _import_wire()

SOCKET = "/run/herdr-anchor/anchor.sock"
# A session whose keeper never comes back is closed after this many seconds
# of *awake* time. Time spent suspended doesn't count: a parked session must
# survive a suspend of any length.
DETACHED_TTL = int(os.environ.get("HERDR_ANCHOR_DETACHED_TTL", "900"))
# A session whose bridge has exited is kept this long for its keeper to come
# back and read the END message, then dropped.
ENDED_SESSION_TTL = 60
# Unacknowledged output kept for replay. Beyond this the session is dropped
# and the client reconnects normally.
MAX_UNACKED = int(os.environ.get("HERDR_ANCHOR_MAX_UNACKED", str(32 * 1024 * 1024)))
SESSION_RE = re.compile(r"^[A-Za-z0-9_-]{16,128}$")
IDLE_TIMEOUT_FLAG = "--idle-timeout-v1"
# The flag as one shell word: bare or quoted, optionally with =value.
IDLE_TIMEOUT_RE = re.compile(r"""[ \t]+(['"]?)--idle-timeout-v1(?:=[^\s'"]*)?\1(?=\s|$)""")


def log(*parts):
    print("[herdr-anchor]", *parts, file=sys.stderr, flush=True)


def bridge_command(cmd):
    """The bridge command herdr asked for, minus its idle timeout.

    With --idle-timeout-v1 the bridge exits after 60 s without traffic, on a
    clock that includes suspended time. The anchor keeps the session itself
    and expires it by awake time instead.

    herdr's command is a short shell script (a ready marker, then
    `exec herdr ... remote-client-bridge [--idle-timeout-v1] ...`). The flag is
    removed as a whole shell word, bare, quoted or with `=value`; the rest of
    the script keeps its exact quoting. The result is checked by parsing it.
    """
    stripped = IDLE_TIMEOUT_RE.sub("", cmd)
    try:
        left = [w for w in shlex.split(stripped)
                if w == IDLE_TIMEOUT_FLAG or w.startswith(IDLE_TIMEOUT_FLAG + "=")]
    except ValueError:
        log("WARNING: could not parse the bridge command to check it")
        return stripped
    if left:
        log(f"WARNING: {IDLE_TIMEOUT_FLAG} is still in the bridge command; the bridge may exit after a suspend")
    return stripped


class Session:
    """One herdr client session: its bridge process and the keeper attached to it."""

    def __init__(self, sid, proc):
        self.sid = sid
        self.proc = proc
        self.output = wire.ReplayBuffer()  # bridge output the keeper hasn't acknowledged
        self.input_total = 0               # bytes received from the keeper
        self.unacked_input = 0             # received since the last ACK we sent
        self.writer = None                 # current keeper transport
        self.handler = None                # the task relaying its input; may outlive
                                           # the writer (a failed write detaches it)
        self.sent = 0                      # output offset already written to self.writer
        self.end_sent = False
        self.stdin_closed = False
        self.detached_ticks = 0
        self.ended = None                  # reason, once the bridge has exited
        self.write_lock = asyncio.Lock()

    @property
    def tag(self):
        return f"session {self.sid[:8]}"

    def attached(self):
        return self.writer is not None and not self.writer.is_closing()

    def append_output(self, chunk):
        """Record bridge output. False once more than MAX_UNACKED is pending."""
        self.output.append(chunk)
        return len(self.output) <= MAX_UNACKED

    def acknowledged(self, offset):
        """The keeper has our output up to `offset`."""
        self.output.trim_to(offset)

    async def attach(self, writer, keeper_received, status):
        """Make `writer` this session's transport: WELCOME, then replay."""
        async with self.write_lock:
            self.writer = writer
            self.handler = asyncio.current_task()
            self.detached_ticks = 0
            self.end_sent = False
            writer.write(wire.encode(wire.WELCOME, json.dumps(
                {"status": status, "recv": self.input_total}).encode()))
            # Replay everything the keeper hasn't seen; the keeper does the same.
            self.output.trim_to(keeper_received)
            self.sent = keeper_received
            replayed = len(self.output)
            await self._flush_locked()
        return replayed

    async def flush(self, trailer=b""):
        """Write the output the transport hasn't had yet, then `trailer`
        (an already encoded message, such as an ACK)."""
        async with self.write_lock:
            await self._flush_locked(trailer)

    async def send_ack(self):
        self.unacked_input = 0
        await self.flush(wire.encode_ack(self.input_total))

    async def _flush_locked(self, trailer=b""):
        if not self.attached():
            return
        data = self.output.since(self.sent)
        try:
            if data:
                self.writer.write(wire.encode(wire.DATA, data))
                self.sent = self.output.total
            if trailer:
                self.writer.write(trailer)
            if self.ended and not self.end_sent and self.sent == self.output.total:
                self.writer.write(wire.encode(wire.END, json.dumps({"reason": self.ended}).encode()))
                self.end_sent = True
            await self.writer.drain()
        except (ConnectionError, RuntimeError):
            self.detach(self.writer)

    async def to_bridge(self, data):
        """Input from the keeper. Counted as soon as it is handed to the
        bridge, before any await: a takeover can then cancel this task only
        before the write or after the count, never between them."""
        if self.proc.returncode is None and not self.stdin_closed:
            try:
                self.proc.stdin.write(data)
            except (BrokenPipeError, ConnectionResetError) as error:
                self.stdin_closed = True
                log(f"{self.tag}: bridge input closed ({error}); its output and END follow")
        self.input_total += len(data)
        self.unacked_input += len(data)
        if not self.stdin_closed and self.proc.returncode is None:
            try:
                await self.proc.stdin.drain()
            except (BrokenPipeError, ConnectionResetError) as error:
                self.stdin_closed = True
                log(f"{self.tag}: bridge input closed ({error}); its output and END follow")
        if self.unacked_input >= wire.ACK_EVERY:
            await self.send_ack()

    async def take_over(self):
        """Detach the current keeper transport and wait until its handler has
        stopped, so nothing it already read can reach the bridge after the new
        transport's WELCOME has reported our position."""
        old_writer, old_handler = self.writer, self.handler
        self.handler = None
        if old_writer is not None:
            self.detach(old_writer)
            old_writer.close()
        if old_handler is not None and old_handler is not asyncio.current_task() and not old_handler.done():
            old_handler.cancel()
            await asyncio.wait([old_handler])

    def detach(self, writer):
        if self.writer is writer:
            self.writer = None
            self.detached_ticks = 0

    def kill(self):
        if self.proc.returncode is None:
            try:
                self.proc.kill()
            except ProcessLookupError:
                pass


class Anchor:
    def __init__(self):
        self.sessions = {}

    async def new_session(self, sid, cmd):
        proc = await asyncio.create_subprocess_exec(
            "/bin/sh", "-c", bridge_command(cmd),
            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
            stderr=None, start_new_session=True,
        )
        session = Session(sid, proc)
        self.sessions[sid] = session
        asyncio.create_task(self.pump_output(session))
        log(f"{session.tag}: bridge started (pid {proc.pid})")
        return session

    async def pump_output(self, session):
        while True:
            chunk = await session.proc.stdout.read(65536)
            if not chunk:
                break
            if not session.append_output(chunk):
                log(f"{session.tag}: over {MAX_UNACKED} unacknowledged bytes, dropping it")
                session.kill()
                break
            await session.flush()
        await session.proc.wait()
        session.ended = f"bridge exited with status {session.proc.returncode}"
        log(f"{session.tag}: {session.ended}")
        await session.flush()

    def close(self, session, why):
        session.kill()
        if self.sessions.get(session.sid) is session:
            del self.sessions[session.sid]
        log(f"{session.tag}: closed ({why})")

    async def handle(self, reader, writer):
        session = None
        try:
            kind, payload = await wire.read_message(reader)
            if kind != wire.HELLO:
                raise ValueError("expected HELLO")
            hello = json.loads(payload)
            sid, keeper_received = hello.get("session", ""), int(hello.get("recv", 0))
            if hello.get("v") != wire.PROTOCOL_VERSION or not SESSION_RE.match(sid):
                raise ValueError("bad HELLO")
            session = self.sessions.get(sid)
            if session is None and hello.get("cmd") and keeper_received == 0:
                session = await self.new_session(sid, hello["cmd"])
                status = "new"
            elif session is not None and session.output.holds(keeper_received):
                status = "resumed"
                await session.take_over()
            else:
                writer.write(wire.encode(wire.WELCOME, json.dumps({"status": "unknown", "recv": 0}).encode()))
                await writer.drain()
                log(f"session {sid[:8]}: unknown or not resumable (recv {keeper_received})")
                return
            replayed = await session.attach(writer, keeper_received, status)
            if status == "resumed":
                log(f"{session.tag}: resumed (replayed {replayed} bytes)")
            await self.relay(session, reader)
        except (asyncio.IncompleteReadError, ConnectionError):
            pass
        except Exception as error:  # noqa: BLE001 - keep the daemon up
            log(f"connection error: {error}")
        finally:
            if session is not None:
                session.detach(writer)
                if session.handler is asyncio.current_task():
                    session.handler = None
            writer.close()

    async def relay(self, session, reader):
        me = asyncio.current_task()
        while True:
            kind, payload = await wire.read_message(reader)
            if session.handler is not me:
                return  # replaced by a newer connection; its keeper replays this
            if kind == wire.DATA:
                await session.to_bridge(payload)
            elif kind == wire.ACK:
                session.acknowledged(wire.decode_ack(payload))
                # Answer with our own position, so the keeper can trim too.
                await session.send_ack()
            elif kind == wire.CLOSE:
                self.close(session, "keeper closed it")
                return
            else:
                raise ValueError(f"unexpected message type {kind}")

    async def reap(self):
        # Counted in one-second ticks rather than by clock: after a restore
        # from a snapshot, clocks may jump, and suspended time must not count.
        while True:
            await asyncio.sleep(1)
            for session in list(self.sessions.values()):
                if session.attached():
                    continue
                session.detached_ticks += 1
                if session.detached_ticks >= DETACHED_TTL:
                    self.close(session, f"no keeper for {DETACHED_TTL}s of awake time")
                elif session.ended and session.detached_ticks >= ENDED_SESSION_TTL:
                    self.close(session, "bridge ended and nobody came back")


async def serve(path):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    # makedirs leaves an existing directory's mode alone; the socket is root-only.
    os.chmod(directory, 0o700)
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    anchor = Anchor()
    old_umask = os.umask(0o177)
    server = await asyncio.start_unix_server(anchor.handle, path=path, limit=wire.MAX_MESSAGE)
    os.umask(old_umask)
    log(f"listening on {path} (detached sessions expire after {DETACHED_TTL}s awake)")
    asyncio.create_task(anchor.reap())
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, stop.set)
    async with server:
        await stop.wait()
    for session in list(anchor.sessions.values()):
        anchor.close(session, "anchor shutting down")


def attach(path):
    """Pipe stdin/stdout (the SSH channel) to the daemon's socket."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    deadline = time.monotonic() + 10
    while True:
        try:
            sock.connect(path)
            break
        except (FileNotFoundError, ConnectionRefusedError):
            if time.monotonic() > deadline:
                print("herdr-anchor: anchor is not running", file=sys.stderr)
                return 1
            time.sleep(0.2)

    def upload():
        try:
            while True:
                data = os.read(0, 65536)
                if not data:
                    break
                sock.sendall(data)
        except OSError:
            pass
        try:
            sock.shutdown(socket.SHUT_WR)
        except OSError:
            pass

    threading.Thread(target=upload, daemon=True).start()
    try:
        while True:
            data = sock.recv(65536)
            if not data:
                break
            view = memoryview(data)
            while view:
                view = view[os.write(1, view):]
    except OSError:
        pass
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--socket", default=os.environ.get("HERDR_ANCHOR_SOCKET", SOCKET))
    parser.add_argument("command", choices=["serve", "attach"])
    args = parser.parse_args()
    if args.command == "serve":
        asyncio.run(serve(args.socket))
        return 0
    return attach(args.socket)


if __name__ == "__main__":
    sys.exit(main())
