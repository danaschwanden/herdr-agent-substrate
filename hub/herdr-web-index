#!/usr/bin/env bash
# herdr-web-index JS OUT: write ttyd's own page with the script JS
# (hub/herdr-web.js) added, for `ttyd --index OUT`. Run once at image build
# (hub/Dockerfile). The page comes from the ttyd binary on PATH (started for a
# moment on a private Unix socket), so it always matches ttyd's version.
set -euo pipefail

js="${1:?usage: herdr-web-index JS OUT}"
out="${2:?usage: herdr-web-index JS OUT}"
[[ -f "${js}" ]] || { echo "herdr-web-index: ${js} not found" >&2; exit 1; }

# A short path: Unix socket paths are limited to about 100 bytes.
tmp="$(mktemp -d /tmp/herdr-web.XXXXXX)"
trap 'kill "${pid:-}" 2>/dev/null || true; rm -rf "${tmp}"' EXIT
ttyd -i "${tmp}/ttyd.sock" true >/dev/null 2>&1 &
pid=$!
# ttyd takes -i as a Unix socket only when it ends in .sock. The file appears
# before ttyd accepts on it, so retry the request.
for _ in $(seq 1 50); do
  curl -fsS --unix-socket "${tmp}/ttyd.sock" -o "${tmp}/index.html" http://localhost/ 2>/dev/null && break
  sleep 0.1
done
[[ -s "${tmp}/index.html" ]] || { echo "herdr-web-index: could not fetch ttyd's page" >&2; exit 1; }

python3 - "${tmp}/index.html" "${js}" "${out}" <<'PY'
import sys
page, js, out = sys.argv[1:]
html = open(page, encoding="utf-8").read()
script = open(js, encoding="utf-8").read()
if html.count("</body>") != 1:
    sys.exit("herdr-web-index: unexpected ttyd page (no single </body>)")
html = html.replace("<title>ttyd - Terminal</title>", "<title>herdr</title>")
html = html.replace("</body>", "<script>\n" + script + "\n</script></body>")
open(out, "w", encoding="utf-8").write(html)
PY
