#!/usr/bin/env bash
# hubctl: actor lifecycle from inside the herdr hub pod.
#
# Every actor's herdr machine stays enabled and looks online all the time.
# Suspending is invisible to the herdr client because herdr-keeper sits
# between the client and each actor (see hub/herdr-keeper, actor/herdr-anchor):
#   suspend: park the keepers (they drop their connection and answer the
#            client's health pings themselves), cut leftover tunnels, then
#            suspend the actor;
#   resume:  happens by itself on the next keystroke or request: the keeper
#            reconnects through the router, which resumes the actor.
set -euo pipefail

: "${ATESPACE:?ATESPACE is not set}"
ATE_API_ENDPOINT="${ATE_API_ENDPOINT:-api.ate-system.svc:443}"
ATE_API_TOKEN="${ATE_API_TOKEN:-/var/run/ate/api-token/token}"
IDLE_SECONDS="${IDLE_SECONDS:-300}"
POLL_SECONDS="${POLL_SECONDS:-30}"
KEEPER_RUN="${HERDR_KEEPER_RUN:-/tmp/herdr-keepers}"
# For `create`: the kit's ActorTemplate, and its default egress policy, which
# `host/herdr-substrate.sh hub` renders from manifests/egress-policy.yaml.tmpl
# (with the cluster's CREDENTIAL_URI) into a ConfigMap mounted here.
HUB_TEMPLATE="${HUB_TEMPLATE:-herdr-agent}"
HUB_EGRESS_POLICY="${HUB_EGRESS_POLICY:-/etc/herdr-hub/policy/egress-policy.yaml}"
STATE_DIR="${HOME}/.herdr-hub"
mkdir -p "${STATE_DIR}"
# hubctl's own ssh and herdr --machine calls go straight to the actor, never
# through a keeper: they must not count as user activity.
export HERDR_KEEPER_BYPASS=1

log()  { printf '[hubctl] %s\n' "$*" >&2; }
die()  { log "error: $*"; exit 1; }

ate() { kubectl-ate --endpoint "${ATE_API_ENDPOINT}" --token-file "${ATE_API_TOKEN}" "$@"; }

# ate_actor VERB KIND NAME [ARGS...]: an ate call on one object in ATESPACE.
ate_actor() {
  local verb="$1" kind="$2" name="$3"; shift 3
  ate "${verb}" "${kind}" "${name}" -a "${ATESPACE}" "$@"
}

validate_name() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || die "actor name '$1' must be a DNS label"
}

# machine_id LABEL: herdr profile id of the saved machine with that label.
machine_id() {
  herdr machine list --json | jq -r --arg want "$1" 'first(.[] | select(.label == $want) | .id) // empty'
}

# ate_labels: the label of every saved ate-* machine, one per line.
ate_labels() {
  herdr machine list --json | jq -r '.[] | select(.target | startswith("ate-")) | .label'
}

cut_tunnel() { pkill -f -- "ate-target-actor: ${ATESPACE}/$1\$" 2>/dev/null || true; }

# keepers NAME REQUEST: send a JSON request to every keeper of machine NAME,
# print one JSON reply per line. Sockets of keepers that are gone are removed.
keepers() {
  python3 - "${KEEPER_RUN}/$1" "$2" <<'PY'
import glob, json, os, socket, sys
directory, request = sys.argv[1], sys.argv[2]
for path in sorted(glob.glob(os.path.join(directory, "*.sock"))):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(15)
    try:
        sock.connect(path)
        sock.sendall(request.encode() + b"\n")
        data = b""
        while not data.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
        print(data.decode().strip() or json.dumps({"error": "no reply", "socket": path}))
    except (ConnectionRefusedError, FileNotFoundError):
        try:
            os.unlink(path)
        except OSError:
            pass
    except OSError as error:
        print(json.dumps({"error": str(error), "socket": path}))
    finally:
        sock.close()
PY
}

# keeper_replies FILTER: run a jq FILTER over the replies `keepers` printed,
# one parsed reply at a time; a line that isn't JSON becomes {"error": line}.
keeper_replies() { jq -Rr "select(length > 0) | (fromjson? // {error: .}) | $1"; }

# actor_states: "<name> <state>" for every actor in the atespace.
actor_states() {
  ate get actors -a "${ATESPACE}" -o json 2>/dev/null \
    | jq -r '.actors[]? | "\(.metadata.name) \(.status.state // "UNKNOWN")"' 2>/dev/null || true
}

cmd_add() {
  local name="${1:?usage: hubctl add <actor>}"; validate_name "${name}"
  log "first SSH contact with ate-${name} (resumes the actor if suspended)"
  # -F: OpenSSH finds ~/.ssh/config through the password database, not $HOME.
  ssh -F "${HOME}/.ssh/config" -o BatchMode=yes "ate-${name}" 'herdr --version' >/dev/null \
    || die "ssh ate-${name} failed; try: ssh -F ~/.ssh/config -vvv ate-${name} true"
  if [[ -n "$(machine_id "${name}")" ]]; then
    log "machine ${name} already saved"
  else
    herdr machine add "ate-${name}" --label "${name}"
  fi
}

# create NAME [--policy FILE]: actor, egress policy and herdr machine in one go.
# Each part is skipped when it already exists, so a failed create can be re-run.
cmd_create() {
  local name="" policy="${HUB_EGRESS_POLICY}" current
  while (( $# )); do
    case "$1" in
      --policy) [[ -n "${2:-}" ]] || die "--policy needs a file"; policy="$2"; shift 2 ;;
      --policy=*) policy="${1#--policy=}"; shift ;;
      -*) die "unknown option $1 (usage: hubctl create <actor> [--policy FILE])" ;;
      *) [[ -z "${name}" ]] || die "one actor at a time"; name="$1"; shift ;;
    esac
  done
  [[ -n "${name}" ]] || die "usage: hubctl create <actor> [--policy FILE]"
  validate_name "${name}"
  [[ -s "${policy}" ]] || die "no egress policy at ${policy}; pass --policy FILE, or run 'host/herdr-substrate.sh hub' to install the default"

  if ate_actor get actor "${name}" >/dev/null 2>&1; then
    log "actor ${ATESPACE}/${name} exists"
  else
    log "creating actor ${ATESPACE}/${name} from template ${HUB_TEMPLATE}"
    ate_actor create actor "${name}" --template "${HUB_TEMPLATE}" >/dev/null
  fi
  # A missing egress policy prints nothing and exits 0.
  current="$(ate_actor get egress-policy "${name}" -o json 2>/dev/null)" \
    || die "could not read the egress policy of ${ATESPACE}/${name}"
  if [[ -n "${current}" ]]; then
    log "egress policy of ${name} exists; left as it is"
  else
    log "egress policy for ${name}: ${policy}"
    ate_actor create egress-policy "${name}" -f "${policy}" >/dev/null
  fi
  cmd_add "${name}"
  log "created ${name}; it shows up in herdr's sidebar"
}

# delete NAME: the reverse of create. The machine goes first, so no client
# reconnects (and so resumes) the actor while it is being deleted.
cmd_delete() {
  local name="${1:?usage: hubctl delete <actor>}"; validate_name "${name}"
  cmd_remove "${name}"
  ate_actor delete egress-policy "${name}" >/dev/null 2>&1 || true
  if ate_actor get actor "${name}" >/dev/null 2>&1; then
    ate_actor delete actor "${name}" >/dev/null
    log "deleted actor ${ATESPACE}/${name} and its snapshot"
  else
    log "actor ${ATESPACE}/${name} does not exist"
  fi
}

cmd_remove() {
  local name="${1:?usage: hubctl remove <actor>}" id; validate_name "${name}"
  id="$(machine_id "${name}")"
  if [[ -n "${id}" ]]; then herdr machine remove "${id}" >/dev/null; fi
  # Close any keeper still attached to the forgotten machine before cutting
  # tunnels: a keeper that only lost its tunnel would reconnect through the
  # router and resume the actor.
  keepers "${name}" '{"cmd":"close"}' >/dev/null
  cut_tunnel "${name}"
  rm -f "${STATE_DIR}/last-active.${name}"
}

# suspend NAME [--force]: park NAME's keepers, then suspend the actor. Without
# --force, a keeper whose client is in use (recent input or output) cancels
# the suspend. With --force, keepers park anyway; what they hold is replayed
# on the next wake, so the actor stays suspended until the next input.
cmd_suspend() {
  local name="${1:?usage: hubctl suspend <actor> [--force]}" force=false refused
  validate_name "${name}"
  [[ "${2:-}" == --force ]] && force=true
  refused="$(keepers "${name}" "{\"cmd\":\"park\",\"force\":${force}}" \
    | keeper_replies 'select(.result != "parked") | .result // .error' | paste -sd, -)"
  if [[ -n "${refused}" ]]; then
    [[ "${force}" == true ]] \
      || { log "${name}: not suspending, keeper reported: ${refused}"; return 3; }
    log "${name}: WARNING: keeper could not park (${refused}); it will resume the actor when it connects"
  fi
  # herdr's own SSH master (probes, --machine calls) keeps sending keepalives
  # for up to 10 minutes; parked keepers have no connection left to cut.
  cut_tunnel "${name}"
  log "suspending ${ATESPACE}/${name}"
  ate_actor suspend actor "${name}"
  rm -f "${STATE_DIR}/last-active.${name}"
}

cmd_resume() {
  local name="${1:?usage: hubctl resume <actor>}"; validate_name "${name}"
  log "resuming ${ATESPACE}/${name}"
  ate_actor resume actor "${name}"
  # Attached clients: reconnect now rather than on the next keystroke.
  keepers "${name}" '{"cmd":"wake"}' >/dev/null
}

# agents_busy LABEL: prints busy, idle or unknown (the list can't be read).
agents_busy() {
  local verdict
  verdict="$(herdr --machine "$1" agent list 2>/dev/null | jq -r '
    .result.agents
    | if type != "array" then "unknown"
      elif any(.[]; .agent_status == "working" or .agent_status == "blocked") then "busy"
      else "idle" end' 2>/dev/null)" || true
  echo "${verdict:-unknown}"
}

# input_idle LABEL: seconds since anyone typed into or opened LABEL in an
# attached herdr client (the smallest across keepers); empty if none attached.
input_idle() {
  keepers "$1" '{"cmd":"status"}' | keeper_replies '.input_idle | numbers' \
    | sort -n | head -n 1 | cut -d. -f1
}

# touch_marker FILE TIME: move the last-activity marker forward to TIME, never
# back (input seen long ago must not undo a more recent busy agent).
touch_marker() {
  local last
  last="$(cat "$1" 2>/dev/null || echo 0)"
  (( $2 > last )) && echo "$2" >"$1"
  return 0
}

# One pass of the idle bridge. Only RUNNING actors are looked at: polling a
# suspended one would resume it.
idle_pass() {
  local now name state marker unknown idle last
  now="$(date +%s)"
  declare -A states=()
  while read -r name state; do
    [[ -n "${name}" ]] && states["${name}"]="${state}"
  done < <(actor_states)
  for name in $(ate_labels); do
    marker="${STATE_DIR}/last-active.${name}"
    unknown="${STATE_DIR}/agents-unknown.${name}"
    if [[ "${states[${name}]:-}" != ACTOR_STATE_RUNNING ]]; then
      rm -f "${marker}" "${unknown}"
      continue
    fi
    [[ -f "${marker}" ]] || echo "${now}" >"${marker}"
    idle="$(input_idle "${name}")"
    if [[ -n "${idle}" ]] && (( idle < IDLE_SECONDS )); then
      touch_marker "${marker}" "$(( now - idle ))"
    fi
    # unknown: the agent list could not be read. Counted as busy, so an actor
    # is never suspended under an agent we can't see; logged once per spell.
    case "$(agents_busy "${name}")" in
      busy) touch_marker "${marker}" "${now}"; rm -f "${unknown}" ;;
      unknown)
        touch_marker "${marker}" "${now}"
        [[ -f "${unknown}" ]] \
          || { log "${name}: WARNING: can't read its agent list; not suspending it until it can be read"; touch "${unknown}"; } ;;
      *) rm -f "${unknown}" ;;
    esac
    last="$(cat "${marker}")"
    if (( now - last >= IDLE_SECONDS )); then
      log "${name}: no working/blocked agent and no input for ${IDLE_SECONDS}s"
      cmd_suspend "${name}" || true
    fi
  done
}

cmd_idle_watch() {
  log "idle bridge: suspend actors after ${IDLE_SECONDS}s without working/blocked agents or input"
  while :; do
    idle_pass || log "idle pass failed"
    sleep "${POLL_SECONDS}"
  done
}

cmd_status() {
  ate get actors -a "${ATESPACE}" || true
  echo
  herdr machine list || true
  local name
  for name in $(ate_labels 2>/dev/null); do
    keepers "${name}" '{"cmd":"status"}' \
      | keeper_replies 'select(.state) | "keeper \(.machine) (pid \(.pid)): \(.state), input idle \(.input_idle)s"'
  done
}

usage() {
  cat <<EOF
Usage: hubctl <command> [args]   (atespace: ${ATESPACE})

  create <actor> [--policy FILE]
                           new actor from ${HUB_TEMPLATE}, its egress policy (default:
                           the kit's policy, the APIs of the agents in AGENTS with
                           credentials injected) and herdr machine
  delete <actor>           remove the machine, the egress policy and the actor
  add <actor>              pin the actor's host key and save it as herdr machine <actor>
  remove <actor>           forget the herdr machine (the actor stays)
  suspend <actor> [--force] park attached clients' keepers, cut tunnels, suspend the actor
  resume <actor>           resume the actor and reconnect attached clients' keepers
  idle-watch               loop: suspend actors idle for IDLE_SECONDS (runs as a service)
  idle-pass                one iteration of idle-watch
  status                   actors, herdr machines and keepers
  ate <args...>            kubectl-ate with the hub's endpoint and token
  pubkey                   the hub's SSH public key (goes into the ActorTemplate)
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "${cmd}" in
    create) cmd_create "$@" ;;
    delete) cmd_delete "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    suspend) cmd_suspend "$@" ;;
    resume) cmd_resume "$@" ;;
    idle-watch) cmd_idle_watch ;;
    idle-pass) idle_pass ;;
    status) cmd_status ;;
    ate) ate "$@" ;;
    pubkey) cat "${HOME}/.ssh/id_ed25519.pub" ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
