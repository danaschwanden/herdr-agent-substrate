# One agent CLI's real credential: Claude's (an API key, or a subscription
# token from `claude setup-token`, by CLAUDE_AUTH), OpenAI's or Gemini's.
# Secrets anthropic, openai and gemini live in a namespace only the credential
# provider reads; actors in ${ATESPACE} are granted access to it through the
# provider's namespace policy (the setup script adds that grant).
apiVersion: v1
kind: Namespace
metadata:
  name: ${SECRETS_NAMESPACE}
---
apiVersion: v1
kind: Secret
metadata:
  name: ${SECRET_NAME}
  namespace: ${SECRETS_NAMESPACE}
type: Opaque
stringData:
  ${CREDENTIAL_KEY}: ${CREDENTIAL_JSON}
