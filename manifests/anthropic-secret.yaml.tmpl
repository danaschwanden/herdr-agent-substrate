# The real Anthropic API key. It lives in a namespace only the credential
# provider reads; actors in ${ATESPACE} are granted access to it through the
# provider's namespace policy (the setup script adds that grant).
apiVersion: v1
kind: Namespace
metadata:
  name: ${SECRETS_NAMESPACE}
---
apiVersion: v1
kind: Secret
metadata:
  name: anthropic
  namespace: ${SECRETS_NAMESPACE}
type: Opaque
stringData:
  api-key: ${ANTHROPIC_API_KEY_JSON}
